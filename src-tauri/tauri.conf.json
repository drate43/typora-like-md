{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markview",
  "version": "0.7.109",
  "identifier": "app.markview.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Markview",
        "width": 1280,
        "height": 840,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$HOME/**/*"],
          "deny": ["$HOME/.ssh/**/*", "$HOME/.gnupg/**/*"],
          "requireLiteralLeadingDot": true
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "shortDescription": "A calm Markdown reader and light editor for macOS",
    "longDescription": "Markview is a calm Markdown reader and light editor for macOS. It opens local Markdown folders, renders readable pages, keeps source mode nearby, and supports focused reading, search, themes, tables, Mermaid, and math.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "contentTypes": [
          "io.typora.markdown",
          "net.daringfireball.markdown",
          "net.ia.markdown",
          "public.markdown",
          "com.unknown.md"
        ],
        "name": "Markview Markdown Document",
        "description": "Markview Markdown text document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    }
  }
}
